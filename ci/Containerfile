# Containerfile for argus-ci — CI image for the Argus observability stack.
#
# This image provides:
# - Python 3.13 base + pixi v0.70.2 (pinned release, checksum-verified)
# - Go 1.25.10 (Atlas dashboard: go vet / go test / gosec)
# - gitleaks 8.30.1 (secrets scan)
# - Non-root user 'ci' (uid 1000) for rootless Podman compatibility
#
# The locked pixi project environment is NOT baked into the image: the repo is
# mounted at /workspace at runtime and the env lives under /workspace/.pixi
# (gitignored). run_ci_local.sh mounts a persistent host pixi cache
# (~/.cache/pixi) so 'pixi install --locked' is fast on warm runs.
#
# Build (OCI-compliant — works with both podman and docker):
#   podman build --ignorefile ci/.dockerignore -f ci/Containerfile -t argus-ci:local .
#   docker build -f ci/Containerfile -t argus-ci:local .
#
# Run:
#   podman run --rm -v .:/workspace:Z argus-ci:local pixi run pytest tests/ -v

# ============================================================================
# Stage 0: pixi binary — installed from a pinned GitHub release so the checksum
# is reproducible and the build resolves identically under podman and docker.
# ============================================================================
FROM python:3.13-slim@sha256:6771159cd4fa5d9bba1258caf0b82e6b73458c694d178ad97c5e925c2d0e1a91 AS pixi

RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && curl -fsSL https://github.com/prefix-dev/pixi/releases/download/v0.70.2/pixi-x86_64-unknown-linux-musl.tar.gz -o /tmp/pixi.tar.gz \
    && echo "9d0d72fc1fa1a8f87bfde943cf25d3575cb352cb516795d4dab21898bd98adea  /tmp/pixi.tar.gz" | sha256sum --check \
    && tar xzf /tmp/pixi.tar.gz -C /usr/local/bin \
    && rm /tmp/pixi.tar.gz \
    && pixi --version

# ============================================================================
# Stage 1: Builder — Go + gosec + gitleaks
# ============================================================================
FROM python:3.13-slim@sha256:6771159cd4fa5d9bba1258caf0b82e6b73458c694d178ad97c5e925c2d0e1a91 AS builder

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PATH="/usr/local/go/bin:$PATH"

RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    git \
    curl \
    ca-certificates \
    gcc \
    g++ \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Go toolchain (Atlas dashboard builds)
RUN curl -fsSL https://dl.google.com/go/go1.25.10.linux-amd64.tar.gz -o /tmp/go.tar.gz \
    && echo "42d4f7a32316aa66591eca7e89867256057a4264451aca10570a715b3637ba70  /tmp/go.tar.gz" | sha256sum --check \
    && tar -C /usr/local -xzf /tmp/go.tar.gz \
    && rm /tmp/go.tar.gz

# gosec (lint job, Go dashboard)
RUN GOBIN=/usr/local/bin go install github.com/securego/gosec/v2/cmd/gosec@v2.27.1

# gitleaks (secrets scan) — same pin as the workflow (GITLEAKS_VERSION 8.30.1)
RUN curl -sSfL https://github.com/gitleaks/gitleaks/releases/download/v8.30.1/gitleaks_8.30.1_linux_x64.tar.gz \
    | tar -xz -C /usr/local/bin gitleaks \
    && gitleaks version

# ============================================================================
# Stage 2: Runtime — minimal image without build tools
# ============================================================================
FROM python:3.13-slim@sha256:6771159cd4fa5d9bba1258caf0b82e6b73458c694d178ad97c5e925c2d0e1a91

LABEL org.opencontainers.image.title="argus-ci"
LABEL org.opencontainers.image.description="CI container for Argus — validation, linting, testing, security scans"
LABEL org.opencontainers.image.vendor="Argus"
LABEL org.opencontainers.image.source="https://github.com/HomericIntelligence/Argus"

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/usr/local/go/bin:$PATH"

RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    git \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=pixi /usr/local/bin/pixi /usr/local/bin/pixi
COPY --from=builder /usr/local/go /usr/local/go
COPY --from=builder /usr/local/bin/gitleaks /usr/local/bin/gitleaks

# Create non-root user for rootless Podman compatibility
RUN groupadd -r ci && useradd -r -g ci -u 1000 -m -s /bin/bash ci \
    # Pre-create the cache dir chain so volume mounts into $HOME/.cache
    # (e.g. the pixi cache) never leave a root-owned parent that blocks
    # pixi's rattler/uv caches.
    && mkdir -p /home/ci/.cache \
    && chown -R ci:ci /home/ci

WORKDIR /workspace

# No ENTRYPOINT — commands are provided externally by CI or run_ci_local.sh
# Example: podman run --rm -v .:/workspace:Z argus-ci:local pixi run pytest tests/ -v

USER ci
