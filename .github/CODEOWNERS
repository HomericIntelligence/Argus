# Owners are individual usernames because the HomericIntelligence org
# has no `argus-maintainers` or `security` teams yet (issue #369).
# When those teams are created, replace @mvillmow with
# @HomericIntelligence/<team-slug> on the relevant lines.

# Default owner for all files
* @mvillmow

# Prometheus scrape configs and alert rules — security-sensitive (metric poisoning, alert suppression)
/configs/prometheus.yml @mvillmow
/rules/ @mvillmow

# Grafana dashboards and datasource provisioning
/configs/grafana/ @mvillmow
/dashboards/ @mvillmow

# Loki and Promtail configs — log pipeline (log injection risk)
/configs/loki.yml @mvillmow
/configs/promtail.yml @mvillmow

# CI/CD and GitHub configuration
/.github/ @mvillmow

# Top-level operational files — they set network topology, container flags, and
# the task runner every contributor executes, so a change can alter the stack's
# runtime without touching a configs/ path (issue #371). Kept in the same
# root-anchored form as the security-sensitive entries above.
/docker-compose.yml @mvillmow
/justfile @mvillmow
/pixi.toml @mvillmow
